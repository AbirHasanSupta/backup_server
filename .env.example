# Copy this file to .env and replace every placeholder before `docker compose up`.
# Use URL-safe values in POSTGRES_URL, or percent-encode password characters.
API_KEY=replace-with-a-long-random-api-key
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_URL=postgresql://postgres:replace-with-a-long-random-postgres-password@postgres:5432/backup_db
# Set REQUIRE_APPROVAL=false for headless / Docker deployments (auto-accept known API key pairings)
REQUIRE_APPROVAL=false
# Host LAN IPv4 address(es) advertised in /ping so phones can discover this server.
# Required for Docker: container networking cannot see your real Wi-Fi/LAN IP.
# Example: ADVERTISED_IPS=192.168.1.50
ADVERTISED_IPS=
# Port phones should scan (mapped to nginx). Default 8000 matches the Android app.
ADVERTISED_PORT=8000
# Host Tailscale endpoints advertised in /ping (same payload as desktop CLI).
# Install Tailscale on the Docker host, then copy MagicDNS / 100.x from
# `tailscale status`. WireGuard has no discovery API — enter the tunnel IP
# manually in the Android app (Tailscale / WireGuard mode), same as desktop.
# Example: TAILSCALE_IPS=100.64.1.2
# Example: TAILSCALE_DNS_NAME=desktop.tailnet.ts.net
TAILSCALE_IPS=
TAILSCALE_DNS_NAME=
# API gunicorn workers for interactive app-api (memory scan is single-leader).
GUNICORN_WORKERS=4
# Per-Gunicorn-process cap for blocking file/database work on app-api.  Keep
# this bounded: four workers each create their own pool.
API_THREADPOOL_WORKERS=12
# Isolated sync-api container (SERVICE_ROLE=sync).  Owns /upload*, /files/check,
# /sync/* so bulk phone backups do not share the app-api thread pool.
# Desktop/local defaults to SERVICE_ROLE=all (monolith); Docker sets app|sync.
# Default 2 workers keeps Postgres connections under POSTGRES_MAX_CONNECTIONS.
SYNC_GUNICORN_WORKERS=2
SYNC_API_THREADPOOL_WORKERS=16
# Per API process: concurrent video thumbnails on a cold gallery load.
THUMBNAIL_WORKERS=2
# Local timezone for On-This-Day / capture-day bucketing (default: Asia/Dhaka).
# Phones also send local_date for "today"; media_index day buckets use this zone
# at reindex time. Override only if the household is not in Bangladesh.
TZ=Asia/Dhaka
APP_TZ=Asia/Dhaka
# PostgreSQL pools are also per process (Gunicorn + Celery prefork children).
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=8
# Celery queue isolation.  Tune only after measuring CPU and disk latency.
CELERY_VIDEO_CONCURRENCY=2
CELERY_REWIND_CONCURRENCY=1
CELERY_INDEXING_CONCURRENCY=2
# A job's internal FFmpeg fan-out.  These defaults suit a 12-logical-core host
# while preserving capacity for requests and uploads.
FFMPEG_THREADS=2
REWIND_SEGMENT_WORKERS=2
# PostgreSQL / Redis memory tuning for a 16 GB Docker Desktop host.  These are
# conservative defaults; Docker Desktop itself must be allowed at least 8 GB.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_CONNECTIONS=96
REDIS_MAXMEMORY=256mb
# Periodically recycle API workers to release library/native memory growth.
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000
